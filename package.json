{
  "name": "minimal-git-file-history",
  "displayName": "Minimal Git file history",
  "description": "Navigate Git file history with diffs, blame annotations, and commit navigation - similar to JetBrains",
  "version": "0.1.1",
  "publisher": "waydotnet",
  "author": "WaYdotNET (Carlo Bertini)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/waydotnet/minimal-git-file-history"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "media/logo.png",
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "minimalGitFileHistory.showHistory",
        "title": "Show Minimal Git file history",
        "icon": "$(history)"
      },
      {
        "command": "minimalGitFileHistory.showBlame",
        "title": "Toggle Git Blame",
        "icon": "$(person)"
      },
      {
        "command": "minimalGitFileHistory.compareWithPrevious",
        "title": "Compare with Previous Commit"
      },
      {
        "command": "minimalGitFileHistory.compareWithWorking",
        "title": "Compare with Working Directory"
      },
      {
        "command": "minimalGitFileHistory.compareVersions",
        "title": "Compare Two Commits"
      },
      {
        "command": "minimalGitFileHistory.viewCommit",
        "title": "View File at Commit"
      },
      {
        "command": "minimalGitFileHistory.navigateToParent",
        "title": "Navigate to Parent Commit"
      },
      {
        "command": "minimalGitFileHistory.navigateToChild",
        "title": "Navigate to Child Commit"
      },
      {
        "command": "minimalGitFileHistory.openDiffPanel",
        "title": "Open Detailed Diff Panel"
      },
      {
        "command": "minimalGitFileHistory.refresh",
        "title": "Refresh History",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "minimalGitFileHistory.showHistory",
          "when": "resourceLangId != 'git'",
          "group": "git-history"
        },
        {
          "command": "minimalGitFileHistory.compareWithWorking",
          "when": "resourceLangId != 'git'",
          "group": "git-history"
        }
      ],
      "editor/context": [
        {
          "command": "minimalGitFileHistory.showHistory",
          "group": "git-history"
        },
        {
          "command": "minimalGitFileHistory.showBlame",
          "group": "git-history"
        },
        {
          "command": "minimalGitFileHistory.compareWithPrevious",
          "group": "git-history"
        },
        {
          "command": "minimalGitFileHistory.compareWithWorking",
          "group": "git-history"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "minimalGitFileHistory.showHistory",
          "group": "git-history"
        }
      ],
      "view/title": [
        {
          "command": "minimalGitFileHistory.refresh",
          "when": "view == minimalGitFileHistory.view",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "minimalGitFileHistory.viewCommit",
          "when": "view == minimalGitFileHistory.view && viewItem == 'commit'",
          "group": "inline"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "minimalGitFileHistory.view",
          "name": "Minimal Git file history",
          "icon": "media/logo.png",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "configuration": {
      "title": "Minimal Git file history",
      "properties": {
        "minimalGitFileHistory.maxCommits": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of commits to fetch"
        },
        "minimalGitFileHistory.blameEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Git Blame annotations"
        },
        "minimalGitFileHistory.dateFormat": {
          "type": "string",
          "default": "relative",
          "enum": [
            "relative",
            "absolute",
            "both"
          ],
          "description": "Date format for commit display"
        },
        "minimalGitFileHistory.autoLoadOnFileSelect": {
          "type": "boolean",
          "default": false,
          "description": "Automatically load Git history in the Minimal Git file history panel when a file is selected or opened in the editor"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {}
}
